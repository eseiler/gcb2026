{
    "[cpp]": {
        "editor.defaultFormatter": "ebextensions.active-clang-format",
        "editor.formatOnSave": true
    },
    "clang-format.executable": "clang-format-23",
    "cmake.buildDirectory": "${workspaceRoot}/build/${buildKitVendor}-${buildKitVersionMajor}-${buildType}",
    "cmake.buildTask": true,
    "cmake.configureSettings": {
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -O0 -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -march=native -DNDEBUG"
    },
    "cmake.ctest.parallelJobs": 0,
    "cmake.defaultVariants": {
        "buildType": {
            "choices": {
                "debug": {
                    "buildType": "Debug",
                    "long": "Disable optimizations - include debug information.",
                    "short": "Debug"
                },
                "minsize": {
                    "buildType": "MinSizeRel",
                    "long": "Optimize for smallest binary size - exclude debug information.",
                    "short": "MinSizeRel"
                },
                "reldeb": {
                    "buildType": "RelWithDebInfo",
                    "long": "Optimize for speed - include debug information.",
                    "short": "RelWithDebInfo"
                },
                "release": {
                    "buildType": "Release",
                    "long": "Optimize for speed - exclude debug information.",
                    "short": "Release"
                }
            },
            "default": "debug",
            "description": "The build type."
        }
    },
    "cmake.environment": {
        "CLICOLOR_FORCE": "1",
        "CMAKE_COLOR_DIAGNOSTICS": "1"
    },
    "cmake.generator": "Unix Makefiles",
    "cmake.debugConfig": {
        "type": "lldb",
        "request": "launch"
    },
    "cmake.options.advanced": {
        "build": {
            "statusBarVisibility": "visible"
        },
        "buildTarget": {
            "statusBarVisibility": "visible"
        },
        "cpack": {
            "statusBarVisibility": "hidden"
        },
        "ctest": {
            "statusBarVisibility": "hidden"
        },
        "debug": {
            "statusBarVisibility": "visible"
        },
        "launchTarget": {
            "statusBarVisibility": "visible"
        },
        "workflow": {
            "statusBarVisibility": "hidden"
        }
    },
    "cmake.options.statusBarVisibility": "compact",
    "cmake.parallelJobs": 0,
    "cmake.revealLog": "never",
    "cmake.sourceDirectory": "${workspaceRoot}",
    "cmake.useCMakePresets": "never",
    "editor.maxTokenizationLineLength": 500,
    "editor.renderWhitespace": "all",
    "editor.rulers": [
        80,
        120
    ],
    "editor.wordWrapColumn": 120,
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 300,
    "files.insertFinalNewline": true,
    "files.participants.timeout": 0,
    "files.trimTrailingWhitespace": true,
    "files.watcherExclude": {
        "**/.git/**": true,
        "/build/**": true
    },
    "files.exclude": {
        ".clang-format": true,
        ".gitignore": true,
        ".github/**": true,
        "LICENSES/**": true,
        "LICENSE.md": true,
        ".vscode.preset/": true
    },
    "problems.decorations.enabled": false,
    "search.exclude": {
        "/build/**": true
    },
    "statusbar_command.commands": [
        {
            "alignment": "left",
            "command": "cmake.cleanConfigure",
            "priority": 1,
            "text": "$(refresh) Clean Reconfigure",
            "tooltip": "Delete Cache and Reconfigure"
        },
        {
            "alignment": "left",
            "command": "cmake.debugTarget",
            "priority": 0,
            "text": "$(bug) Debug",
            "tooltip": "Launch Target with Debugger"
        }
    ],
    "terminal.integrated.scrollback": 500000,
    "terminal.integrated.smoothScrolling": true,
    "workbench.colorCustomizations": {
        "editorRuler.foreground": "#3c3c3cd2"
    },
    "workbench.colorTheme": "Visual Studio Dark",
    "workbench.editor.empty.hint": "hidden",
    "workbench.editor.tabSizing": "shrink",
    "workbench.list.multiSelectModifier": "alt",
    "workbench.startupEditor": "newUntitledFile",
    "nextflow.telemetry.enabled": false,
    "cmake.automaticReconfigure": true,
    "cmake.configureOnEdit": false,
    "cmake.configureOnOpen": false
}
