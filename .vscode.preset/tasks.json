{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cmake",
            "label": "Build",
            "command": "build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": "absolute"
            },
            "options": {
                "environment": {
                    "CMAKE_COLOR_DIAGNOSTICS": "1",
                    "CLICOLOR_FORCE": "1"
                }
            }
        }
    ]
}
